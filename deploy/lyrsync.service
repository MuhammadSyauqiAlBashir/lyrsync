[Unit]
Description=lyrsync backend (FastAPI)
After=network-online.target pocketbase.service
Wants=network-online.target

[Service]
Type=simple
User=lyrsync
Group=lyrsync
WorkingDirectory=/opt/lyrsync
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/lyrsync/env
ExecStart=/opt/lyrsync/venv/bin/uvicorn app:app --app-dir /opt/lyrsync \
  --host 127.0.0.1 --port 8000 --workers 1 \
  --proxy-headers --forwarded-allow-ips 127.0.0.1 \
  --no-server-header --no-access-log
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=lyrsync
StateDirectoryMode=0700

# Resource limits (1GB box)
MemoryHigh=180M
MemoryMax=260M
TasksMax=64

# Sandbox: read-only everything, no writable paths needed
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Blocked calls fail with EPERM instead of killing the process (numpy probes mbind).
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=true

[Install]
WantedBy=multi-user.target
